{
    "name": "petethered/archive-site",
    "description": "Crawl and archive a JS-rendered website into a deployable static site.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "ArchiveSite\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ArchiveSite\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
